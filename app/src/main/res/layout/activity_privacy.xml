<?xml version="1.0" encoding="utf-8"?>
<LinearLayout

    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".activity_privacy">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WALL-ART"
            android:layout_marginHorizontal="15dp"
            android:textSize="20dp"
            android:textColor="@color/black"
            android:textStyle="bold"/>

    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:isScrollContainer="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="Privacy Policy"
            android:textSize="40dp"
            android:padding="20dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Thank you for choosing WallArt, a mobile wallpaper application. This Privacy Policy outlines how we collect, use, and safeguard the information you provide when using our application. We value your privacy and are committed to protecting your personal information. Please read this policy carefully to understand our practices regarding your data."
                android:padding="7dp"
                android:layout_marginLeft="5dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="1. Information We Collect"
                android:padding="7dp"
                android:layout_marginLeft="5dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="1.1 Personal Information:"
                android:padding="7dp"
                android:layout_marginLeft="15dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="When you use WallArt, we may collect certain personal information that you voluntarily provide, such as your name, email address, profile picture, and other details required for registration or customization of the application."
                android:padding="7dp"
                android:layout_marginLeft="15dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="1.2 Device Information:"
                android:padding="7dp"
                android:layout_marginLeft="15dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="We may collect certain device-specific information, including your device model, operating system version, unique device identifiers, and mobile network information. This information helps us optimize our application for your specific device and improve your overall experience."
                android:padding="7dp"
                android:layout_marginLeft="15dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="1.3 Usage Information:"
                android:padding="7dp"
                android:layout_marginLeft="15dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="We collect information about how you use the WallArt application, such as the wallpapers you download, the time and date of your interactions, and the duration of your sessions. This data helps us understand user preferences and improve our services."
                android:padding="7dp"
                android:layout_marginLeft="15dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="7dp"
                android:text="2. Use of Collected Information"
                android:layout_marginLeft="5dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="7dp"
                android:text="2.1 Personal Information:"
                android:layout_marginLeft="15dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="7dp"
                android:text="We may use the personal information you provide to us for the following purposes:"
                android:layout_marginLeft="15dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="7dp"
                android:text="- To create and manage your account on WallArt."
                android:layout_marginLeft="15dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="7dp"
                android:text="-To provide you with personalized wallpapers and recommendations."
                android:layout_marginLeft="15dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="7dp"
                android:text="-To send you notifications, updates, and promotional materials related to the application."
                android:layout_marginLeft="15dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="7dp"
                android:text="-To respond to your inquiries and provide customer support."
                android:layout_marginLeft="15dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="7dp"
                android:text="-To improve our application's functionality and user experience."
                android:layout_marginLeft="15dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="7dp"
                android:text="-To analyze trends and usage patterns to enhance our services."
                android:layout_marginLeft="15dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="7dp"
                android:text="2.2 Non-Personal Information:"
                android:layout_marginLeft="15dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="7dp"
                android:text="We may use non-personal information, such as device information and usage data, for analytical purposes, such as understanding user preferences, improving our application, and delivering relevant content and advertisements."
                android:layout_marginLeft="15dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="7dp"
                android:text="3. Data Sharing and Disclosure"
                android:layout_marginLeft="5dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="7dp"
                android:text="3.1 Third-Party Service Providers:"
                android:layout_marginLeft="15dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="7dp"
                android:text="We may share your personal and non-personal information with trusted third-party service providers who assist us in delivering and improving our application. These providers are contractually obligated to protect your information and are restricted from using it for any other purpose."
                android:layout_marginLeft="15dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="7dp"
                android:text="3.2 Legal Requirements:"
                android:layout_marginLeft="15dp"/>


            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="7dp"
                android:text="We may disclose your information if required to do so by law, court order, or governmental request, or to protect our rights, property, or safety, as well as the rights, property, or safety of our users or others."
                android:layout_marginLeft="15dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="7dp"
                android:text="4. Data Security"
                android:layout_marginLeft="5dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="7dp"
                android:layout_marginLeft="5dp"
                android:text="We implement industry-standard security measures to protect your information from unauthorized access, alteration, disclosure, or destruction. However, please be aware that no method of transmission over the internet or electronic storage is 100% secure, and we cannot guarantee absolute security." />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="7dp"
                android:text="5. Your Choices and Rights"
                android:layout_marginLeft="5dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="7dp"
                android:text="5.1 Opt-Out:"
                android:layout_marginLeft="15dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="7dp"
                android:text="You may opt-out of receiving promotional communications from WallArt by following the instructions provided in the application settings or contacting us directly."
                android:layout_marginLeft="15dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="7dp"
                android:text="5.2 Access, Update, and Delete:"
                android:layout_marginLeft="15dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="7dp"
                android:text="You may request access to, update, or delete your personal information we hold about you by contacting us directly. However, please note that certain information may be retained as required by law or for legitimate business purposes."
                android:layout_marginLeft="15dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="7dp"
                android:text="6. Third-Party Links and Services"
                android:layout_marginLeft="5dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="7dp"
                android:layout_marginLeft="5dp"
                android:text="The WallArt application may contain links to third-party websites, services, and advertisements that are not owned or controlled by us. This Privacy Policy does not apply to such third-party activities. We encourage you to review the privacy policies of those third parties before providing any personal information."/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="7dp"
                android:layout_marginLeft="5dp"
                android:text="7. Children's Privacy"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="7dp"
                android:layout_marginLeft="5dp"
                android:text="WallArt is not intended for individuals under the age of 7. We do not knowingly collect or solicit personal information from children. If we discover that we have inadvertently collected personal information from a child without parental consent, we will promptly take steps to delete the information."/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="7dp"
                android:layout_marginLeft="5dp"
                android:text="8. Changes to this Privacy Policy"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="7dp"
                android:layout_marginLeft="5dp"
                android:text="We reserve the right to modify this Privacy Policy at any time. The updated version will be effective upon posting within the WallArt application. We encourage you to review this policy periodically. Your continued use of WallArt after any modifications signifies your acknowledgment and acceptance of the revised Privacy Policy."/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="7dp"
                android:layout_marginLeft="5dp"
                android:text="9. Contact Us"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="7dp"
                android:layout_marginLeft="5dp"
                android:text="If you have any questions, concerns, or requests regarding this Privacy Policy or our data practices, please contact us at wallart8833@gmail.com"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="By using the WallArt application or providing your personal information, you signify your consent to the terms of this Privacy Policy."
                android:padding="7dp"
                android:layout_marginLeft="5dp"
                android:layout_marginBottom="100dp"/>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>